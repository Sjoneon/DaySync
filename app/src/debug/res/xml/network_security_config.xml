<?xml version="1.0" encoding="utf-8"?>
<!-- 개발용 빌드에서만 HTTP 허용 (출시 빌드는 main의 설정으로 차단) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>